##############################
# Backstage .env.example
# NO COMMITAS SECRETS REALES
# Uso: copia a IDP/.env y ajusta.
##############################

# --- PostgreSQL (local dev) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=backstage
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me-local

# --- Auth Key (mecanismo moderno) ---
# Genera con: openssl rand -base64 48
BACKEND_AUTH_KEYS_0_SECRET=CHANGE_ME_SECURE_KEY

# --- GitHub OAuth App ---
# Crea el OAuth App:
#   Homepage: https://backstage.local
#   Callback: https://backstage.local/api/auth/github/handler/frame
GITHUB_CLIENT_ID=__YOUR_GH_CLIENT_ID__
GITHUB_CLIENT_SECRET=__YOUR_GH_CLIENT_SECRET__

# --- GitHub Token (Opcional) ---
# Usa GitHub App o scopes mínimos (read:user). Si no lo necesitas, déjalo vacío.
GITHUB_TOKEN=

# --- Notas ---
# Este archivo es SOLO para desarrollo local.
# En Kubernetes usa Secrets (o Sealed/External Secrets) en lugar de este .env.
# Rotación recomendada de BACKEND_AUTH_KEYS_0_SECRET cada 60-90 días.

