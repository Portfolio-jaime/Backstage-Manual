# Backstage .env.example (NO COMMITAS SECRETS REALES)
# Copia este archivo a `.env` y reemplaza valores.

# --- Backend Auth ---
BACKEND_AUTH_SECRET=replace-with-random-hex
BACKEND_AUTH_KEYS_0_SECRET=replace-with-random-hex

# --- GitHub OAuth (Login) ---
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_CLIENT_SECRET=replace-with-client-secret

# --- GitHub PAT (Catalog / Scaffolder) ---
GITHUB_TOKEN=replace-with-pat-or-remove

# --- Postgres (Producción) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=backstage
POSTGRES_USER=backstage
POSTGRES_PASSWORD=replace-with-db-password

# Nota: Para producción usa Secrets Kubernetes, este .env solo para local.
